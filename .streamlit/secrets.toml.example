# =====================================================================
# TEMPLATE ONLY: these are fake placeholder values.
# The real file is .streamlit/secrets.toml (same folder). It's listed in
# .gitignore, so it never goes to GitHub. When we deploy, the same values
# get pasted into the Streamlit Cloud dashboard instead.
# =====================================================================

# The website's address. On your PC it's localhost.
# After deploying (Phase 4), change it to your .streamlit.app address.
app_url = "http://localhost:8501"

# --- Supabase database (Phase 1) ---
# Supabase dashboard -> Project Settings -> API Keys.
# Use the SECRET key (starts with sb_secret_), never the publishable one.
# It can read every row, so it must only ever live in this file.
supabase_url = "https://YOUR-PROJECT-ID.supabase.co"
supabase_secret_key = "sb_secret_PASTE_YOURS_HERE"

# Scrambles everyone's WHOOP and Google tokens before they're saved to the
# database, so a database leak alone can't unlock anyone's account.
# Claude will generate this for you in Phase 1.
token_encryption_key = "GENERATED_IN_PHASE_1"

# --- Claude API (Phase 2) ---
# console.anthropic.com -> API Keys.
anthropic_api_key = "sk-ant-PASTE_YOURS_HERE"

# --- WHOOP developer app (Phase 1) ---
# developer-dashboard.whoop.com -> your app.
[whoop]
client_id = "PASTE_WHOOP_CLIENT_ID"
client_secret = "PASTE_WHOOP_CLIENT_SECRET"

# --- "Sign in with Google" for the website (Phase 1) ---
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client.
# Phase 3 reuses this same Google client for Google Calendar.
# Streamlit requires this section to be called [auth].
[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
cookie_secret = "GENERATED_IN_PHASE_1"
client_id = "PASTE_GOOGLE_CLIENT_ID.apps.googleusercontent.com"
client_secret = "PASTE_GOOGLE_CLIENT_SECRET"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
